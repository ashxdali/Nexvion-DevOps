FROM nginx:alpine

LABEL maintainer="Nexvion DevOps Project"
LABEL description="Hardened Nexvion static e-commerce website"

RUN apk update && apk upgrade --no-cache \
    && rm -rf /usr/share/nginx/html/* \
    && mkdir -p /tmp/client_temp /tmp/proxy_temp \
                /tmp/fastcgi_temp /tmp/uwsgi_temp /tmp/scgi_temp \
    && chown -R 101:101 /tmp

COPY application/ /usr/share/nginx/html/
COPY docker/nginx/nginx.conf /etc/nginx/nginx.conf

USER 101:101

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
