pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    environment {
        COMPOSE_FILE = 'docker/docker-compose.hardened.yml'
        DOCKERFILE = 'docker/Dockerfile.hardened'
        IMAGE_NAME = 'nexvion-ecommerce:hardened'
        CONTAINER_NAME = 'nexvion-web-hardened'
        APP_URL = 'http://localhost:18086/'
        ROLLBACK_IMAGE = 'nexvion-ecommerce:rollback'
    }

    stages {
        stage('Verify Project') {
            steps {
                sh '''
                    set -eu

                    test -f application/index.html
                    test -f application/products.html
                    test -f application/payment.html
                    test -f "$DOCKERFILE"
                    test -f "$COMPOSE_FILE"
                    test -f docker/nginx/nginx.conf
                    test -f scripts/security-scan.sh

                    echo "Project files verified."
                '''
            }
        }

	        stage('Secret Scan') {
            steps {
                sh '''
                    set -eu

                    trivy fs \
                        --scanners secret \
                        --skip-dirs .git \
                        --skip-dirs logging/collected \
                        --skip-dirs logging/reports \
                        --exit-code 1 \
                        --format table \
                        .

                    echo "Trivy repository secret scan passed."
                '''
            }
        }

        stage('Dependency Scan') {
            steps {
                sh '''
                    set -eu

                    mkdir -p security/reports

                    trivy fs \
                        --scanners vuln \
                        --skip-dirs .git \
                        --skip-dirs logging/collected \
                        --skip-dirs logging/reports \
                        --format json \
                        --output security/reports/nexvion-dependency-report.json \
                        --severity HIGH,CRITICAL \
                        --ignore-unfixed \
                        --exit-code 1 \
                        .

                    echo "Dependency vulnerability scan passed."
                '''
            }
        }


        stage('Validate Hardened Compose') {
            steps {
                sh '''
                    set -e
                    docker compose -f "$COMPOSE_FILE" config -q

                    echo "Hardened Compose configuration is valid."
                '''

        }
        stage('Capture Previous Image') {
            steps {
                sh '''
                    set -eu

                    mkdir -p security/reports
                    rm -f security/reports/previous-image-id.txt
                    rm -f security/reports/deployment-attempted.txt

                    if docker image inspect "$IMAGE_NAME" >/dev/null 2>&1; then
                        PREVIOUS_IMAGE_ID=$(docker image inspect \
                            --format '{{.Id}}' "$IMAGE_NAME")

                        docker image tag "$PREVIOUS_IMAGE_ID" "$ROLLBACK_IMAGE"

                        printf '%s\\n' "$PREVIOUS_IMAGE_ID" \
                            > security/reports/previous-image-id.txt

                        echo "Previous image preserved for rollback."
                    else
                        : > security/reports/previous-image-id.txt
                        echo "No previous image exists; rollback is unavailable for the first deployment."
                    fi
                '''
            }
        }

        stage('Build Hardened Image') {
            steps {
                sh '''
                    set -eu

                    docker build \
                        -f "$DOCKERFILE" \
                        -t "$IMAGE_NAME" .

                    echo "Hardened Docker image built successfully."
                '''
            }
        }

        stage('Security Scan') {
            steps {
                sh '''
                    set -eu

                    chmod +x scripts/security-scan.sh

                    TRIVY_EXIT_CODE=1 \
                        ./scripts/security-scan.sh "$IMAGE_NAME"

                    echo "Trivy image scan passed."
                '''
            }
        }

        stage('Deploy Hardened Application') {
            steps {
                sh '''
                    set -eu
                    touch security/reports/deployment-attempted.txt

                    docker compose -f "$COMPOSE_FILE" up -d --no-build

                    echo "Hardened application deployment completed."
                '''
            }
        }

        stage('Verify Deployment') {
            steps {
                sh '''
                    set -eu

                    attempt=1

                    while [ "$attempt" -le 12 ]; do
                        if curl --fail --silent --show-error \
                            "$APP_URL" -o /dev/null; then
                            echo "Website HTTP verification passed."
                            break
                        fi

                        if [ "$attempt" -eq 12 ]; then
                            echo "Website HTTP verification failed."
                            exit 1
                        fi

                        echo "Waiting for website... attempt $attempt of 12"
                        attempt=$((attempt + 1))
                        sleep 5
                    done

                    attempt=1

                    while [ "$attempt" -le 12 ]; do
                        health=$(docker inspect \
                            --format '{{.State.Health.Status}}' \
                            "$CONTAINER_NAME")

                        echo "Container health: $health"

                        if [ "$health" = "healthy" ]; then
                            echo "Container health verification passed."
                            exit 0
                        fi

                        if [ "$health" = "unhealthy" ]; then
                            echo "Container reported unhealthy."
                            exit 1
                        fi

                        if [ "$attempt" -eq 12 ]; then
                            echo "Container did not become healthy in time."
                            exit 1
                        fi

                        attempt=$((attempt + 1))
                        sleep 5
                    done
                '''
            }
        }
    }

     post {
        success {
            echo 'Nexvion hardened CI/CD pipeline completed successfully.'
        }

        failure {
            echo 'Pipeline failed. Checking whether rollback is possible.'

            sh '''
                set +e

                PREVIOUS_FILE="security/reports/previous-image-id.txt"
                ATTEMPTED_FILE="security/reports/deployment-attempted.txt"

                if [ -f "$ATTEMPTED_FILE" ] &&
                   [ -s "$PREVIOUS_FILE" ] &&
                   docker image inspect "$ROLLBACK_IMAGE" >/dev/null 2>&1; then

                    echo "Previous image found. Starting rollback."

                    docker image tag "$ROLLBACK_IMAGE" "$IMAGE_NAME"

                    if docker compose -f "$COMPOSE_FILE" up -d --no-build; then
                        attempt=1

                        while [ "$attempt" -le 12 ]; do
                            if curl --fail --silent --show-error \
                                --max-time 10 "$APP_URL" -o /dev/null; then
                                echo "Rollback completed and HTTP verification passed."
                                exit 0
                            fi

                            echo "Waiting for rollback verification: attempt $attempt"
                            sleep 5
                            attempt=$((attempt + 1))
                        done

                        echo "WARNING: Rollback deployment started, but HTTP verification failed."
                    else
                        echo "WARNING: Rollback deployment failed."
                    fi
                else
                    echo "No valid previous image available for rollback."
                fi

            '''
        }

        always {
            archiveArtifacts(
                artifacts: 'security/reports/*.json,security/reports/*.txt',
                allowEmptyArchive: true,
                fingerprint: true
            )

            echo 'Pipeline execution finished.'
        }
    }
}
