pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    environment {
        COMPOSE_FILE = 'docker/docker-compose.yml'
        IMAGE_NAME = 'nexvion-ecommerce:1.0'
    }

    stages {
        stage('Verify Project') {
            steps {
                sh '''
                    set -eu

                    test -f application/index.html
                    test -f application/products.html
                    test -f application/payment.html
                    test -f docker/Dockerfile
                    test -f "$COMPOSE_FILE"

                    echo "Project files verified."
                '''
            }
        }

        stage('Validate Compose') {
            steps {
                sh '''
                    set -eu

                    docker compose -f "$COMPOSE_FILE" config -q

                    echo "Compose configuration is valid."
                '''
            }
        }

        stage('Build Docker Image') {
            steps {
                sh '''
                    set -eu

                    docker build \
                      -f docker/Dockerfile \
                      -t "$IMAGE_NAME" .

                    echo "Docker image built successfully."
                '''
            }
        }

        stage('Verify Image') {
            steps {
                sh '''
                    set -eu

                    docker image inspect "$IMAGE_NAME" >/dev/null

                    echo "Docker image verified: $IMAGE_NAME"
                '''
            }
        }
    }

    post {
        success {
            echo 'Nexvion CI pipeline completed successfully.'
        }

        failure {
            echo 'Pipeline failed. Review the stage logs.'
        }

        always {
            echo 'Pipeline execution finished.'
        }
    }
}
