pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    environment {
        COMPOSE_FILE = 'docker/docker-compose.yml'
        IMAGE_NAME = 'nexvion-ecommerce:1.0'
        APP_URL = 'http://localhost:8086/'
    }

    stages {

        stage('Verify Project') {
            steps {
                sh '''
                    set -eu

                    test -f application/index.html
                    test -f application/products.html
                    test -f application/payment.html
                    test -f docker/Dockerfile
                    test -f "$COMPOSE_FILE"
                    test -f scripts/security-scan.sh

                    echo "Project files verified."
                '''
            }
        }

        stage('Validate Compose') {
            steps {
                sh '''
                    set -eu

                    docker compose -f "$COMPOSE_FILE" config -q

                    echo "Compose configuration is valid."
                '''
            }
        }

        stage('Build Docker Image') {
            steps {
                sh '''
                    set -eu

                    docker build \
                        -f docker/Dockerfile \
                        -t "$IMAGE_NAME" .

                    echo "Docker image built successfully."
                '''
            }
        }

        stage('Security Scan') {
            steps {
                sh '''
                    set -eu

                    chmod +x scripts/security-scan.sh

                    TRIVY_EXIT_CODE=1 \
                        ./scripts/security-scan.sh "$IMAGE_NAME"
                '''
            }
        }

        stage('Deploy Application') {
            steps {
                sh '''
                    set -eu

                    docker compose -f "$COMPOSE_FILE" up -d --build

                    echo "Application deployment completed."
                '''
            }
        }

        stage('Verify Deployment') {
            steps {
                sh '''
                    set -eu

                    for attempt in $(seq 1 12); do
                        if curl --fail --silent --show-error "$APP_URL" -o /dev/null; then
                            echo "Website is responding successfully."
                            exit 0
                        fi

                        echo "Waiting for website... attempt $attempt of 12"
                        sleep 5
                    done

                    echo "Website health verification failed."
                    exit 1
                '''
            }
        }
    }

    post {
        success {
            echo 'Nexvion CI/CD pipeline completed successfully.'
        }

        failure {
            echo 'Pipeline failed. Review the Console Output.'
        }

        always {
            echo 'Pipeline execution finished.'
        }
    }
}
