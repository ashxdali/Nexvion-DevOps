pipeline {
    agent any

    environment {
        IMAGE_NAME = 'nexvion-ecommerce:hardened'
        ROLLBACK_IMAGE = 'nexvion-ecommerce:rollback'
        COMPOSE_FILE = 'docker/docker-compose.hardened.yml'
        APP_URL = 'http://localhost:18086/'
    }

    options {
        timestamps()
        disableConcurrentBuilds()
        timeout(time: 30, unit: 'MINUTES')
    }

    stages {
        stage('Checkout and Validate Project') {
            steps {
                checkout scm

                sh '''
                    set -eu

                    test -f application/index.html
                    test -f application/products.html
                    test -f docker/Dockerfile.hardened
                    test -f "$COMPOSE_FILE"
                    test -x scripts/security-scan.sh

                    echo "Project files verified."
                '''
            }
        }

        stage('Secret Scan') {
            steps {
                sh '''
                    set -eu

                    mkdir -p security/reports

                    trivy fs \
                        --scanners secret \
                        --skip-dirs .git \
                        --skip-dirs logging/collected \
                        --skip-dirs logging/reports \
                        --exit-code 1 \
                        --format table \
                        .

                    echo "Repository secret scan passed."
                '''
            }
        }


        stage('Validate Hardened Compose') {
            steps {
                sh '''
                    set -eu

                    docker compose -f "$COMPOSE_FILE" config -q

                    echo "Hardened Docker Compose configuration is valid."
                '''
            }
        }

        stage('Capture Previous Image') {
            steps {
                sh '''
                    set -eu

                    mkdir -p security/reports

                    rm -f security/reports/previous-image-id.txt
                    rm -f security/reports/deployment-attempted.txt

                    if docker image inspect "$IMAGE_NAME" >/dev/null 2>&1; then
                        PREVIOUS_IMAGE_ID=$(docker image inspect \
                            --format '{{.Id}}' "$IMAGE_NAME")

                        docker image tag "$PREVIOUS_IMAGE_ID" "$ROLLBACK_IMAGE"

                        printf '%s\\n' "$PREVIOUS_IMAGE_ID" \
                            > security/reports/previous-image-id.txt

                        echo "Previous image preserved for rollback."
                    else
                        : > security/reports/previous-image-id.txt

                        echo "No previous image exists; rollback is unavailable for the first deployment."
                    fi
                '''
            }
        }

        stage('Build Hardened Image') {
            steps {
                sh '''
                    set -eu

                    docker compose \
                        -f "$COMPOSE_FILE" \
                        build --pull

                    echo "Hardened Docker image built successfully."
                '''
            }
        }

        stage('Security Scan') {
            steps {
                sh '''
                    set -eu

                    mkdir -p security/reports

                    TRIVY_EXIT_CODE=1 \
                        ./scripts/security-scan.sh "$IMAGE_NAME"

                    echo "Trivy image scan passed."
                '''
            }
        }

        stage('Dependency / Image Vulnerability Scan') {
            steps {
                sh '''
                    set -eu

                    mkdir -p security/reports

                    trivy image \
                        --scanners vuln \
                        --format json \
                        --output security/reports/nexvion-trivy-report.json \
                        --severity HIGH,CRITICAL \
                        --ignore-unfixed \
                        --exit-code 1 \
                        "$IMAGE_NAME"

                    echo "Image vulnerability report generated."
                '''
            }
        }

        stage('Deploy Hardened Application') {
            steps {
                sh '''
                    set -eu

                    touch security/reports/deployment-attempted.txt

                    docker compose \
                        -f "$COMPOSE_FILE" \
                        up -d --no-build

                    echo "Hardened application deployment completed."
                '''
            }
        }

        stage('Verify Deployment') {
            steps {
                sh '''
                    set -eu

                    curl --fail --silent --show-error \
                        --max-time 10 \
                        "$APP_URL" \
                        -o /dev/null

                    echo "HTTP deployment verification passed."
                '''
            }
        }

        stage('Verify Container Health') {
            steps {
                sh '''
                    set -eu

                    CONTAINER_NAME='nexvion-web-hardened'

                    for attempt in $(seq 1 12); do
                        STATUS=$(docker inspect \
                            --format '{{.State.Status}}' \
                            "$CONTAINER_NAME" 2>/dev/null || true)

                        HEALTH=$(docker inspect \
                            --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}not-configured{{end}}' \
                            "$CONTAINER_NAME" 2>/dev/null || true)

                        if [ "$STATUS" = "running" ] && [ "$HEALTH" = "healthy" ]; then
                            echo "Container is running and healthy."
                            exit 0
                        fi

                        echo "Waiting for container health: status=$STATUS health=$HEALTH"
                        sleep 5
                    done

                    echo "Container failed health verification."
                    exit 1
                '''
            }
        }
    }

    post {
        failure {
            script {
                echo 'Pipeline failed. Checking whether rollback is possible.'

                sh(
                    script: '''
                        set +e

                        PREVIOUS_FILE='security/reports/previous-image-id.txt'
                        ATTEMPTED_FILE='security/reports/deployment-attempted.txt'

                        if [ ! -f "$ATTEMPTED_FILE" ]; then
                            echo "Deployment was not attempted; rollback is not required."
                            exit 0
                        fi

                        if [ ! -s "$PREVIOUS_FILE" ]; then
                            echo "No previous image ID is available; automatic rollback is not possible."
                            exit 0
                        fi

                        if ! docker image inspect "$ROLLBACK_IMAGE" >/dev/null 2>&1; then
                            echo "Rollback image is unavailable."
                            exit 1
                        fi

                        docker image tag "$ROLLBACK_IMAGE" "$IMAGE_NAME"

                        if ! docker compose -f "$COMPOSE_FILE" up -d --no-build; then
                            echo "Rollback deployment command failed."
                            exit 1
                        fi

                        for attempt in $(seq 1 12); do
                            if curl --fail --silent --show-error \
                                --max-time 10 "$APP_URL" -o /dev/null; then
                                echo "Rollback completed; HTTP verification passed."
                                exit 0
                            fi

                            sleep 5
                        done

                        echo "Rollback attempted, but HTTP verification did not succeed."
                        exit 1
                    ''',
                    returnStatus: true
                )
            }
        }

        always {
            archiveArtifacts(
                artifacts: 'security/reports/*.json,security/reports/*.txt',
                allowEmptyArchive: true,
                fingerprint: true
            )

            echo 'Pipeline execution finished.'
        }

        success {
            echo 'Nexvion hardened CI/CD pipeline completed successfully.'
        }
    }
}
