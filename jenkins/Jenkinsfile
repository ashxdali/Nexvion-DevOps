pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    environment {
        PROJECT_NAME = 'Nexvion'
        COMPOSE_FILE = 'docker/docker-compose.yml'
        IMAGE_NAME = 'nexvion-ecommerce:1.0'
    }

    stages {
        stage('Checkout Verification') {
            steps {
                echo 'Checking out the Nexvion project workspace.'

                sh '''
                    set -eu

                    test -f application/index.html
                    test -f application/products.html
                    test -f application/payment.html
                    test -f docker/Dockerfile
                    test -f docker/docker-compose.yml

                    echo "Application and Docker files verified."
                '''
            }
        }

        stage('Validate Docker Compose') {
            steps {
                sh '''
                    set -eu

                    docker compose -f "$COMPOSE_FILE" config -q

                    echo "Docker Compose configuration is valid."
                '''
            }
        }

        stage('Build Docker Image') {
            steps {
                sh '''
                    set -eu

                    docker build \
                        -f docker/Dockerfile \
                        -t "$IMAGE_NAME" \
                        .
                '''
            }
        }

        stage('Verify Application') {
            steps {
                sh '''
                    set -eu

                    test -f application/index.html

                    echo "Application files are present."
                    echo "Image built: $IMAGE_NAME"
                '''
            }
        }
    }

    post {
        success {
            echo 'Nexvion CI pipeline completed successfully.'
        }

        failure {
            echo 'Nexvion CI pipeline failed. Review the stage logs.'
        }

        always {
            echo 'Nexvion pipeline execution finished.'
        }
    }
}
